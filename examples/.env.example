# Remote Chromium 环境变量配置
# 复制为 .env 并按需修改

# ========== 容器配置 ==========
CHROME_CONTAINER_NAME=remote-chromium
CHROME_IMAGE=remote-chromium:latest

# 工作目录
SERVER_BROWSER_WORK_DIR=$HOME/remote-chromium

# Chromium 数据持久化目录
CHROME_CONFIG_DIR=$HOME/remote-chromium/config

# Chrome 扩展目录（挂载到容器内 /config/extensions/）
# 多个扩展放在各自子目录下，如 ./extensions/opencli-webstore/, ./extensions/ublock/
CHROME_EXTENSIONS_DIR=$HOME/remote-chromium/extensions

# Chrome 管理策略文件
CHROME_POLICIES_FILE=$HOME/remote-chromium/configs/managed_policies.json

# ========== 端口配置 ==========
# KasmVNC 内部端口（避免与宿主机其他服务冲突）
KASM_HTTP_PORT=3800
KASM_HTTPS_PORT=3801

# Chromium CDP 端口（容器内 localhost）
CHROME_CDP_PORT=9222

# CDP 代理端口（暴露给宿主机）
CHROME_CDP_PROXY_PORT=9224

# CDP 代理绑定地址
# 127.0.0.1  = 仅本地可访问（默认，安全）
# 0.0.0.0    = 对外暴露（不推荐，需配合防火墙）
CDP_PROXY_BIND=127.0.0.1

# Chromium --remote-allow-origins 参数
# 默认: http://localhost:<CDP_PROXY_PORT>，仅允许本地 CDP 代理
# 设为 * 允许所有来源（不推荐，有 CSRF 风险）
# CHROME_CDP_ALLOW_ORIGINS=

# ========== 运行用户 ==========
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Chromium 共享内存大小
CHROME_SHM_SIZE=1gb

# ========== 鉴权配置 ==========
# 鉴权模式：basic | oidc
# basic  = OpenResty Basic Auth
# oidc   = OAuth2-Proxy + OIDC Provider（如 Keycloak）
AUTH_MODE=basic

# --- Basic Auth ---
CHROME_AUTH_USER=your-user
CHROME_AUTH_PASS=your-password

# --- OIDC ---
# OIDC Provider 地址（以 Keycloak 为例）
KEYCLOAK_BASE_URL=https://auth.example.com:8443
# OIDC Provider realm / tenant
KEYCLOAK_REALM=your-realm
# OpenResty 暴露给用户的域名
CHROME_DOMAIN=chrome.example.com
CHROME_HTTPS_PORT=8443
# OAuth2-Proxy 容器名
OAUTH2_PROXY_CONTAINER_NAME=oauth2-proxy-remote-chromium
# OAuth2-Proxy 环境文件路径
OAUTH2_PROXY_ENV_FILE=$HOME/remote-chromium/configs/oauth2-proxy.env
# OAuth2-Proxy 镜像版本（锁定版本避免 :latest 不可复现问题）
# 注意: v7.7.1 存在 OIDC audience 校验兼容性问题（Keycloak token aud 不匹配导致 500）
# v7.8.2+ 已修复此问题。如遇到 audience 相关 500 错误，请升级版本。
OAUTH2_PROXY_VERSION=v7.8.2

# ========== 反向代理 ==========
# OpenResty 容器名（用于 apply-auth-mode.sh 自动部署反代配置）
OPENRESTY_CONTAINER=your-openresty-container
