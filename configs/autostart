#!/bin/bash
# KasmVNC openbox autostart for Remote Chromium
set -u

export DISPLAY="${DISPLAY:-:1}"
export LIBGL_ALWAYS_SOFTWARE=1

# Paths
CONFIG_DIR=/config
CHROME_USER_DATA="$CONFIG_DIR/chromium"
CDP_PORT="${CHROMIUM_CDP_PORT:-9222}"
CDP_PROXY_PORT="${CHROMIUM_CDP_PROXY_PORT:-9224}"
BUILD_TIME_EXT_DIR="/opt/extensions"
RUNTIME_EXT_DIR="${EXTENSIONS_DIR:-/config/extensions}"

# Scan for Chrome extensions (each subdirectory must contain manifest.json)
# Priority: runtime-mounted extensions > build-time extensions
# Deduplicate by extension name (directory basename)
declare -A SEEN_EXTS
EXT_PATHS=""

scan_extensions() {
    local base_dir="$1"
    if [ ! -d "$base_dir" ]; then
        return
    fi
    for sub in "$base_dir"/*/; do
        if [ -f "${sub}manifest.json" ]; then
            local name
            name="$(basename "${sub%/}")"
            if [ -z "${SEEN_EXTS[$name]:-}" ]; then
                SEEN_EXTS["$name"]=1
                if [ -z "$EXT_PATHS" ]; then
                    EXT_PATHS="${sub%/}"
                else
                    EXT_PATHS="$EXT_PATHS,${sub%/}"
                fi
            else
                echo "[autostart] Skipping duplicate extension: $name (already loaded)"
            fi
        fi
    done
}

# Runtime-mounted extensions take priority
scan_extensions "$RUNTIME_EXT_DIR"
# Build-time extensions as fallback
scan_extensions "$BUILD_TIME_EXT_DIR"

if [ -z "$EXT_PATHS" ]; then
    echo "[autostart] Warning: no Chrome extensions found, starting Chromium without extensions"
    EXT_FLAG=""
else
    echo "[autostart] Loading extensions: $EXT_PATHS"
    EXT_FLAG="--load-extension=$EXT_PATHS"
fi

# Launch socat to expose CDP from localhost:CDP_PORT to 0.0.0.0:CDP_PROXY_PORT
# Modern Chromium binds CDP to 127.0.0.1 only; we need a proxy for external access.
/opt/socat-cdp.sh "$CDP_PORT" "$CDP_PROXY_PORT" &

# Chromium launch flags
CHROME_FLAGS="
    --no-sandbox
    --no-first-run
    --no-default-browser-check
    --start-maximized
    --password-store=basic
    --disable-gpu
    --disable-background-networking
    --user-data-dir=$CHROME_USER_DATA
    --remote-debugging-port=$CDP_PORT
    --remote-allow-origins=*
    --lang=zh-CN
"

if [ -n "$EXT_FLAG" ]; then
    CHROME_FLAGS="$CHROME_FLAGS $EXT_FLAG"
fi

# Keep window from being minimized (same trick as WechatOnCloud)
(
    while sleep 2; do
        all=$(xdotool search --name '.+' 2>/dev/null) || continue
        vis=$(xdotool search --onlyvisible --name '.+' 2>/dev/null)
        for w in ${all}; do
            printf '%s\n' "${vis}" | grep -qx "${w}" || xdotool windowactivate "${w}" 2>/dev/null || true
        done
    done
) &

echo "[autostart] Starting Chromium with flags: $CHROME_FLAGS"
exec /usr/bin/chromium $CHROME_FLAGS
